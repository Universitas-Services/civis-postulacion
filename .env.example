# Portal del postulante — configuración
# Copiar a .env.local:  cp .env.example .env.local
#
# La sesión se guarda cifrada en una cookie HttpOnly que el navegador no puede
# leer. El token de acceso NUNCA llega al cliente: las llamadas a la API salen
# desde el servidor de Next.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# URL que usa el servidor de Next para hablar con la API (puede diferir de la
# pública si la API vive en una red interna).
API_INTERNAL_URL=http://localhost:3001/api/v1

NEXT_PUBLIC_APP_NAME=Postulación al TSJ
SESSION_COOKIE_NAME=cp_post_session
# CHANGE_ME: generar con `openssl rand -base64 48`
SESSION_SECRET=CHANGE_ME_genera_un_secreto_aleatorio_de_al_menos_32_caracteres

# Nombre de la cookie de refresh que setea la API (path /api/v1/auth).
API_REFRESH_COOKIE_NAME=cp_refresh

# URL pública de este portal (sin barra final). Se usa en los redirects de
# /api/sesion/renovar y /api/sesion/expirada.
POSTULACION_PUBLIC_URL=http://localhost:3000
